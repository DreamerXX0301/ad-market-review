# Use an absolute path. Do not put the key text here.
SHIXU_MASTER_KEY_FILE=/absolute/private/shixu-secret/master.key
SHIXU_HTTP_PORT=8788
SHIXU_IMAGE_TAG=local
# 0=serial; 1..4=pure CPU child process limit. This does not add a market worker.
SHIXU_SELECTION_CPU_WORKERS=4
# Set to 0 on a public site or to disable the official calendar on a private install.
# SHIXU_EVENT_CALENDAR_ENABLED=0
# Set to 1 on a private instance only after obtaining permission for local CLS metadata collection.
SHIXU_NEWS_CLS_LOCAL_AUTHORIZED=0
